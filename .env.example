# Postgres from docker-compose.yml (port 5433 to avoid clashing with a local 5432)
DATABASE_URL="postgresql://postgres:1234@localhost:5432/test_auth?schema=public"
# Any long random string; signs cookies and encrypts TOTP secrets
BETTER_AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
BETTER_AUTH_URL="http://localhost:3000"
